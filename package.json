{
    "name": "hapiapp-api",
    "type": "module",
    "scripts": {
        "dev": "tsx --watch src/app.ts",
        "debug": "tsx --watch --inspect src/app.ts",
        "build": "rm -rf dist && tsup src/app.ts",
        "serve": "yarn build && node dist/app.js",
        "populate:account": "tsx migration/populate.account.ts",
        "populate:user": "tsx migration/populate.user.ts",
        "populate:access": "tsx migration/populate.access.ts"
    },
    "dependencies": {
        "@hono/node-server": "^1.19.14",
        "argon2": "^0.44.0",
        "dotenv": "^17.4.2",
        "hono": "^4.12.14",
        "http-status-codes": "^2.3.0",
        "jsonwebtoken": "^9.0.3",
        "moment": "^2.30.1",
        "mongoist": "^4.0.2",
        "pg": "^8.23.0",
        "pg-hstore": "^2.3.4",
        "sequelize": "^6.37.8",
        "sqlite3": "^6.0.1",
        "ulid": "^3.0.2",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/lodash": "^4.17.24",
        "@types/node": "^26.2.0",
        "csvtojson": "^2.0.14",
        "sequelize-cli": "^6.6.5",
        "tsup": "^8.5.1",
        "tsx": "^4.23.1",
        "typescript": "^5.8.3"
    },
    "private": true,
    "tsup": {
        "entry": [
            "src/app.ts"
        ],
        "format": [
            "esm"
        ],
        "splitting": false,
        "clean": true
    }
}
