{
  "name": "hapiapp-api",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/app.ts",
    "debug": "bun --watch --inspect src/app.ts",
    "build": "bun build src/app.ts --outdir build --sourcemap --target bun",
    "serve": "bun run build && bun build/app.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.14",
    "dotenv": "^17.4.2",
    "hono": "^4.12.14",
    "http-status-codes": "^2.3.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "ulid": "^3.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.24",
    "@types/node": "^20.11.17",
    "sequelize-cli": "^6.6.5",
    "typescript": "^5.8.3"
  }
}