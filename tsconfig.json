{
    "compilerOptions": {
        "target": "ESNext",
        "module": "commonjs",
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "jsxImportSource": "hono/jsx",
        "rootDir": "./src",
        "outDir": "./build",
        "paths": {
            "@/*": [ "./src/*" ],
        },
        "sourceMap": true,
        "allowJs": true,
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "db", "tests", "build/**/*"]
}