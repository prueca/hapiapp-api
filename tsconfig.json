{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "jsxImportSource": "hono/jsx",
        "rootDir": "./src",
        "outDir": "./dist",
        "paths": {
            "@/*": [ "./src/*" ],
        },
        "sourceMap": true,
        "allowJs": true,
        "types": ["node"],
    },
    "include": ["src/**/*", "migration/**/*"],
    "exclude": ["node_modules", "tests", "dist/**/*"]
}
